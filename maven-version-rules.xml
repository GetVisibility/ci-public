<ruleset comparisonMethod="maven"
         xmlns="https://www.mojohaus.org/VERSIONS/RULE/2.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://www.mojohaus.org/VERSIONS/RULE/2.1.0 https://www.mojohaus.org/versions/versions-model/xsd/rule-2.1.0.xsd">
    <ignoreVersions>
        <ignoreVersion type="regex">.*RC.*</ignoreVersion>
        <ignoreVersion type="regex">.*java.*</ignoreVersion>
        <ignoreVersion type="regex">.*rc.*</ignoreVersion>
        <ignoreVersion type="regex">.*alpha.*</ignoreVersion>
        <ignoreVersion type="regex">.*ALPHA.*</ignoreVersion>
        <ignoreVersion type="regex">.*beta.*</ignoreVersion>
        <ignoreVersion type="regex">.*BETA.*</ignoreVersion>
        <ignoreVersion type="regex">.*Beta.*</ignoreVersion>
        <ignoreVersion type="regex">.*pre.*</ignoreVersion>
        <ignoreVersion type="regex">.*M[1-9]$</ignoreVersion>
        <ignoreVersion type="regex">.^200(2|3).*</ignoreVersion>
    </ignoreVersions>
    <rules>
        <rule groupId="org.testcontainers" artifactId="testcontainers-bom" comparisonMethod="maven">
            <ignoreVersions>
                <ignoreVersion type="range">[1.0.0,)</ignoreVersion>
            </ignoreVersions>
        </rule>
        <rule groupId="org.apache.poi" artifactId="poi" comparisonMethod="maven">
            <ignoreVersions>
                <ignoreVersion type="range">[1.0.0,)</ignoreVersion>
            </ignoreVersions>
        </rule>
        <rule groupId="co.elastic.clients" artifactId="elasticsearch-java" comparisonMethod="maven">
            <ignoreVersions>
                <ignoreVersion type="range">[1.0.0,)</ignoreVersion>
            </ignoreVersions>
        </rule>
        <rule groupId="com.google.protobuf" artifactId="protobuf-java" comparisonMethod="maven">
            <ignoreVersions>
                <ignoreVersion type="range">[1.0.0,)</ignoreVersion>
            </ignoreVersions>
        </rule>
        <rule groupId="org.apache.flink" artifactId="flink-clients" comparisonMethod="maven">
            <ignoreVersions>
                <ignoreVersion type="range">[1.0.0,)</ignoreVersion>
            </ignoreVersions>
        </rule>
        <rule groupId="org.apache.lucene" artifactId="lucene-queryparser" comparisonMethod="maven">
            <ignoreVersions>
                <ignoreVersion type="range">[1.0.0,)</ignoreVersion>
            </ignoreVersions>
        </rule>
        <rule groupId="io.grpc" artifactId="grpc-protobuf" comparisonMethod="maven">
            <ignoreVersions>
                <ignoreVersion type="range">[1.0.0,)</ignoreVersion>
            </ignoreVersions>
        </rule>
        <rule groupId="io.minio" artifactId="minio" comparisonMethod="maven">
            <ignoreVersions>
                <ignoreVersion type="range">[8.5.12,)</ignoreVersion>
            </ignoreVersions>
        </rule>
        <rule groupId="org.junit.jupiter" artifactId="junit-jupiter-engine" comparisonMethod="maven">
            <ignoreVersions>
                <ignoreVersion type="range">[5.12.0,)</ignoreVersion>
            </ignoreVersions>
        </rule>
        <rule groupId="com.squareup.okhttp3" artifactId="okhttp" comparisonMethod="maven">
            <ignoreVersions>
                <ignoreVersion type="range">[5.0.0,)</ignoreVersion>
            </ignoreVersions>
        </rule>
        <rule groupId="org.apache.flink" artifactId="flink-clients" comparisonMethod="maven">
            <ignoreVersions>
                <ignoreVersion type="range">[2.0.0,)</ignoreVersion>
            </ignoreVersions>
        </rule>
        <rule groupId="org.springframework.cloud" artifactId="spring-cloud-contract-wiremock" comparisonMethod="maven">
            <ignoreVersions>
                <ignoreVersion type="range">[5.0.0,)</ignoreVersion>
            </ignoreVersions>
        </rule>
        <rule groupId="org.springframework.cloud" artifactId="spring-cloud-starter-circuitbreaker-resilience4j" comparisonMethod="maven">
            <ignoreVersions>
                <ignoreVersion type="range">[5.0.0,)</ignoreVersion>
            </ignoreVersions>
        </rule>
        <!--        Pause spring boot 4 till it is more tested-->
        <rule groupId="org.springframework.boot" artifactId="spring-boot-starter-parent" comparisonMethod="maven">
            <ignoreVersions>
                <ignoreVersion type="range">[4.0.0,)</ignoreVersion>
            </ignoreVersions>
        </rule>

        <!-- eido-detectors-history: ignore git-sha-qualified dev builds (1.0.N-<sha7>)
             published by DS-ai branch CI. A git-sha is an unknown Maven qualifier, so it
             sorts ABOVE the release (1.0.70-6c88f14 > 1.0.70); without this the auto-bump
             would adopt a dev build over the clean release. Scoped to this artifact. -->
        <rule groupId="com.forcepoint.eido" artifactId="eido-detectors-history" comparisonMethod="maven">
            <ignoreVersions>
                <ignoreVersion type="regex">.*-[0-9a-f]{7,}</ignoreVersion>
            </ignoreVersions>
        </rule>

    </rules>
</ruleset>